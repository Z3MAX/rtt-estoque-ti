# =============================================================================
# Variáveis de ambiente obrigatórias — copie este arquivo para .env e preencha
# NUNCA commite o arquivo .env com valores reais
# =============================================================================

# Neon PostgreSQL — obtenha em: https://console.neon.tech → seu projeto → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Chave secreta para assinar JWTs (mínimo 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL(s) do site para CORS — separe múltiplas com vírgula
# Exemplo: https://sistema.rematiptop.com.br,https://preview-deploy--sistema.netlify.app
SITE_URL=https://sua-url.netlify.app

# Credenciais SMTP — Office 365 / Microsoft 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@rematiptop.com.br
SMTP_PASS=

# Azure AD / Microsoft SSO
# Obtenha no portal Azure → App Registrations → sua app → Overview
MS_TENANT_ID=
MS_CLIENT_ID=

# Variáveis expostas ao frontend (Vite build) — sem segredos, apenas IDs públicos
VITE_MS_TENANT_ID=
VITE_MS_CLIENT_ID=

# URL do Copilot interno (opcional)
VITE_COPILOT_URL=

# Segredo para o endpoint de setup inicial do banco (POST /setup-users)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_SECRET=
